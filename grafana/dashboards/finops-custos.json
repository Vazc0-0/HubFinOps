    {
      "id": 3,
      "title": "Recursos sem dono (sem tag owner)",
      "type": "stat",
      "description": "Recursos sem responsável tendem a ser esquecidos e gerar custo.",
      "datasource": {
        "type": "postgres",
        "uid": "focus-pg"
