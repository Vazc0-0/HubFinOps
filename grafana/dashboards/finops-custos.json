    {
      "id": 2,
      "title": "Custo médio por dia",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "focus-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "focus-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(billed_cost) / NULLIF(count(DISTINCT charge_period_start), 0) AS \"Média diária\" FROM focus_costs WHERE $__timeFilter(charge_period_start)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none"
      }
