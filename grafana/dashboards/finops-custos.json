          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT resource_name AS \"Recurso\", service_name AS \"Serviço\", x_resource_group_name AS \"Resource group\", coalesce(tags->>'owner', 'SEM DONO') AS \"Dono\", sum(billed_cost) AS \"Custo\" FROM focus_costs WHERE $__timeFilter(charge_period_start) GROUP BY 1, 2, 3, 4 ORDER BY 5 DESC"
