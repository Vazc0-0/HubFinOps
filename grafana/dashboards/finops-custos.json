          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "focus-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT resource_name) AS \"Recursos\" FROM focus_costs WHERE NOT (tags ? 'owner') AND $__timeFilter(charge_period_start)"
        }
      ],
      "fieldConfig": {
        "defaults": {
