    {
      "id": 8,
      "title": "Execuções cobradas por dia (Azure Monitor)",
      "type": "barchart",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "focus-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "focus-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(momento, 'DD/MM') AS \"Dia\", sum(total) FILTER (WHERE metrica = 'BillableActionExecutions') AS \"Ações cobradas\", sum(total) FILTER (WHERE metrica = 'BillableTriggerExecutions') AS \"Disparos do gatilho\" FROM azure_metricas GROUP BY momento ORDER BY momento"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "xField": "Dia",
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Últimas execuções",
      "type": "table",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "focus-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "focus-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT inicio AS \"Início\", status AS \"Status\", acoes_rodaram AS \"Rodaram\", acoes_puladas AS \"Puladas\", coalesce(acoes_com_falha, '-') AS \"Ações com falha\", CASE WHEN simulada THEN 'sim' ELSE 'não' END AS \"Simulada\" FROM azure_execucoes ORDER BY inicio DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "Succeeded": {
                  "text": "Sucesso",
                  "color": "green"
                },
                "Failed": {
                  "text": "Falhou",
                  "color": "red"
                },
                "ok": {
                  "text": "OK",
                  "color": "green"
                },
                "falhou": {
                  "text": "Falhou",
                  "color": "red"
                },
                "em andamento": {
                  "text": "Em andamento",
                  "color": "blue"
                },
                "Aberto": {
                  "text": "Aberto",
                  "color": "orange"
                },
                "Resolvido": {
                  "text": "Resolvido",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {}
    },
