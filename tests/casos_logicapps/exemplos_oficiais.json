  {
   "linha_na_pagina": 2061,
   "secao": "Switch action",
   "nome": "Switch",
   "definicao": {
    "type": "Switch",
    "expression": "@body('Send_approval_email')?['SelectedOption']",
    "cases": {
     "Case": {
      "actions": {
       "Send_an_email": {
        "type": "ApiConnection",
        "inputs": {
         "Body": "Thank you for your approval.",
         "Subject": "Response received",
         "To": "Sophie.Owen@contoso.com"
        },
        "host": {
         "connection": {
          "name": "@parameters('$connections')['office365']['connectionId']"
         }
        },
        "method": "post",
        "path": "/Mail"
       },
       "runAfter": {}
      },
      "case": "Approve"
     },
     "Case_2": {
      "actions": {
       "Send_an_email_2": {
        "type": "ApiConnection",
        "inputs": {
         "Body": "Thank you for your response.",
         "Subject": "Response received",
         "To": "Sophie.Owen@contoso.com"
        },
        "host": {
         "connection": {
          "name": "@parameters('$connections')['office365']['connectionId']"
         }
        },
        "method": "post",
        "path": "/Mail"
       },
       "runAfter": {}
      },
      "case": "Reject"
     }
    },
    "default": {
     "actions": {
      "Send_an_email_3": {
       "type": "ApiConnection",
       "inputs": {
        "Body": "Please respond with either 'Approve' or 'Reject'.",
        "Subject": "Please respond",
        "To": "Sophie.Owen@contoso.com"
       },
       "host": {
        "connection": {
         "name": "@parameters('$connections')['office365']['connectionId']"
        }
       },
       "method": "post",
       "path": "/Mail"
      },
      "runAfter": {}
     }
    },
    "runAfter": {
     "Send_approval_email": [
      "Succeeded"
     ]
    }
   },
   "eh_gatilho": false
  },
