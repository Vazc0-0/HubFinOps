{
  "_comentario": "Cada entrada vira o 'inputs' de uma ação Compose chamada 'Teste', dentro de um loop 'Loop'. 'usa' é o que o leitor deve encontrar. Regras oficiais: string que começa com @ é expressão; @{...} é interpolação; @@ é @ literal; texto entre aspas simples é literal ('' escapa a aspa).",
  "fonte": "https://learn.microsoft.com/azure/logic-apps/workflow-definition-language-schema#expressions",
  "casos": [
    {"entrada": "@body('X')", "usa": ["acao:X"]},
    {"entrada": "@@body('X')", "usa": []},
    {"entrada": "texto @{body('X')} e @{outputs('Y')}", "usa": ["acao:X", "acao:Y"]},
    {"entrada": "@concat('body(''X'')', 'abc')", "usa": []},
    {"entrada": "@{if(equals(1,1),'{a}','}')}@{variables('v')}", "usa": ["variavel:v"]},
    {"entrada": "@Body('X')", "usa": ["acao:X"]},
    {"entrada": "@body( 'X' )", "usa": ["acao:X"]},
    {"entrada": "@{triggerOutputs()?['headers']}", "usa": ["gatilho"]},
    {"entrada": "@triggerBody()", "usa": ["gatilho"]},
    {"entrada": "@item()?['a']", "usa": ["item:Loop"]},
    {"entrada": "@items('Loop')", "usa": ["item:Loop"]},
    {"entrada": "e-mail fulano@exemplo.com", "usa": []},
    {"entrada": "@parameters('$connections')", "usa": []},
    {"entrada": "@{parameters('p')}", "usa": ["parametro:p"]},
    {"entrada": "@{result('X')}", "usa": ["acao:X"]},
    {"entrada": "@actions('Y').outputs", "usa": ["acao:Y"]},
    {"entrada": "@json(string(body('X')))", "usa": ["acao:X"]},
    {"entrada": "@{body('Nome com ''aspas''')}", "usa": ["acao:Nome com 'aspas'"]},
    {"entrada": {"a": "@body('X')", "@{variables('k')}": "chave"}, "usa": ["acao:X", "variavel:k"]},
    {"entrada": ["@outputs('Y')", {"b": ["@triggerBody()"]}], "usa": ["acao:Y", "gatilho"]},
    {"entrada": "@{concat('a@b.com ', 'outputs(''Z'')')}", "usa": []},
    {"entrada": "@{variables('a')}-@{variables('b')}", "usa": ["variavel:a", "variavel:b"]},
    {"entrada": "@iterationIndexes('Loop')", "usa": ["item:Loop"]},
    {"entrada": 42, "usa": []},
    {"entrada": "@{body('X')?['valor']}@{body('X')?['outro']}", "usa": ["acao:X"]},
    {"entrada": "@{concat('}', body('X'))} e @{outputs('Y')}", "usa": ["acao:X", "acao:Y"]},
    {"entrada": "início @{concat('{', variables('v'))} fim", "usa": ["variavel:v"]},
    {"entrada": "@{concat('it''s }', body('X'))}", "usa": ["acao:X"]}
  ]
}
